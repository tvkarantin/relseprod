# Base URL of the FastAPI backend. No secrets belong in this file:
# the Apify token lives only in apps/api/.env on the server side.
VITE_API_URL=http://localhost:8000/api/v1

# Public Telegram bot entrypoint. Never put the bot token in frontend env vars.
# Set either the full URL or just the bot username.
VITE_TELEGRAM_BOT_URL=
VITE_TELEGRAM_BOT_USERNAME=
