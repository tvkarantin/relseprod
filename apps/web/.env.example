# Base URL of the FastAPI backend. No secrets belong in this file:
# server-side integration tokens live only in apps/api/.env.
VITE_API_URL=http://localhost:8000/api/v1

# Supabase Auth public client settings. Both values are safe to expose to the browser.
# Never put a Supabase secret/service-role key in VITE_* variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
