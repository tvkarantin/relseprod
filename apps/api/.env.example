APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/relseprod.db

# Apify credentials are optional at this stage — the API starts without them.
# Never commit a real token: keep it only in your local .env file.
APIFY_API_TOKEN=
# Actor id in the "owner/actor-name" form, e.g. apify/instagram-reel-scraper
APIFY_ACTOR_ID=
# Actor input shape: auto | username | direct_urls (auto detects it from the id)
APIFY_ACTOR_INPUT_STYLE=auto
APIFY_RESULTS_LIMIT=20
APIFY_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=3

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4173

# Deepgram Speech-to-Text is optional.
# Never commit a real API key.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_TIMEOUT_SECONDS=180
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_NUMERALS=true
DEEPGRAM_PUNCTUATE=true

# OpenRouter is optional.
# Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_OUTPUT_TOKENS=4096
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_RESPONSE_HEALING=true
OPENROUTER_HTTP_REFERER=http://localhost:4173
OPENROUTER_APP_TITLE=Reels Finder
OPENROUTER_INVALID_RESPONSE_RETRIES=1

LOG_LEVEL=INFO
