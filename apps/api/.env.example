APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local development default. In Vercel production, a connected Supabase
# Marketplace resource injects POSTGRES_URL and the backend uses it automatically.
DATABASE_URL=sqlite:///./data/relseprod.db
POSTGRES_URL=

# YouTube Data API v3 (server-only; never expose in VITE_ variables)
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA_LIMIT=9000
YOUTUBE_MONITORING_ENABLED=true

# Instagram import: Instaloader is the free primary source, Apify is fallback.
INSTAGRAM_PRIMARY_PROVIDER=instaloader
# Optional technical Instagram account. Leave blank to try public profiles anonymously.
INSTALOADER_SESSION_USERNAME=
# Relative paths are resolved from apps/api. Keep the real session file out of git.
INSTALOADER_SESSION_FILE=./data/instagram-session
INSTALOADER_TIMEOUT_SECONDS=30
INSTALOADER_MAX_CONNECTION_ATTEMPTS=2

# Apify fallback credentials. Never commit a real token: keep it only in your local .env file.
APIFY_API_TOKEN=
# Actor id in the "owner/actor-name" form, e.g. apify/instagram-reel-scraper
APIFY_ACTOR_ID=
# Actor input shape: auto | username | direct_urls (auto detects it from the id)
APIFY_ACTOR_INPUT_STYLE=auto
# Candidate pool: the backend persists 5 most-viewed reels, falling back to newest.
APIFY_RESULTS_LIMIT=20
APIFY_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=3

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Deepgram Speech-to-Text is optional.
# Never commit a real API key.
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com/v1
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_TIMEOUT_SECONDS=180
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_UTTERANCES=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_NUMERALS=true
DEEPGRAM_PUNCTUATE=true

# OpenRouter is optional.
# Never commit a real API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_TIMEOUT_SECONDS=180
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_OUTPUT_TOKENS=4096
OPENROUTER_REASONING_EFFORT=low
OPENROUTER_RESPONSE_HEALING=true
OPENROUTER_HTTP_REFERER=http://localhost:4173
OPENROUTER_APP_TITLE=Reels Finder
OPENROUTER_INVALID_RESPONSE_RETRIES=1

LOG_LEVEL=INFO
