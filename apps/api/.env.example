APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/relseprod.db

# Apify credentials are optional at this stage — the API starts without them.
# Never commit a real token: keep it only in your local .env file.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
APIFY_RESULTS_LIMIT=20
APIFY_TIMEOUT_SECONDS=300
APIFY_POLL_INTERVAL_SECONDS=3

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:4173

LOG_LEVEL=INFO
