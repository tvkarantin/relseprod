# Telegram Bot API token from @BotFather. Keep it secret.
TELEGRAM_BOT_TOKEN=

# Random 32+ character value used with Telegram setWebhook secret_token.
# Allowed characters: A-Z a-z 0-9 _ -
TELEGRAM_WEBHOOK_SECRET=

# Public RealsFlow frontend URL.
REALSFLOW_URL=https://realsfinder-github.vercel.app

# Public deployment URL of this bot, without trailing slash.
TELEGRAM_BOT_PUBLIC_URL=https://realsflow-telegram-bot.vercel.app
